{
  "name": "@opengovsg/starter-kitty-logging",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.ts"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opengovsg/starter-kitty.git",
    "directory": "packages/logging"
  },
  "homepage": "https://github.com/opengovsg/starter-kitty/tree/develop/packages/logging#readme",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:report": "api-extractor run --local --verbose",
    "build:docs": "api-documenter markdown --input-folder ../../temp/ --output-folder ../../apps/docs/api/",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" --cache",
    "lint:fix": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "ci:report": "api-extractor run --verbose"
  },
  "dependencies": {
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.9",
    "@opengovsg/eslint-config-starter-kitty": "workspace:*",
    "@opengovsg/prettier-config-starter-kitty": "workspace:*",
    "@swc/core": "^1.6.13",
    "@types/node": "^20",
    "typescript": "^5.4.5",
    "vitest": "^4.1.0"
  },
  "prettier": "@opengovsg/prettier-config-starter-kitty"
}
