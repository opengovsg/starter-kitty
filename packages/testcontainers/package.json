{
  "name": "@opengovsg/testcontainers",
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vitest": {
      "types": "./dist/vitest/index.d.ts",
      "default": "./dist/vitest/index.js"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.ts"
      ],
      "vitest": [
        "./dist/vitest/index.d.ts"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opengovsg/starter-kitty.git",
    "directory": "packages/testcontainers"
  },
  "homepage": "https://github.com/opengovsg/starter-kitty/tree/develop/packages/testcontainers#readme",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:report": "api-extractor run --local --verbose",
    "build:docs": "api-documenter markdown --input-folder ../../temp/ --output-folder ../../apps/docs/api/",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" --cache",
    "lint:fix": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "ci:report": "api-extractor run --verbose"
  },
  "peerDependencies": {
    "testcontainers": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "vitest": "^4.1.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.9",
    "@opengovsg/eslint-config-starter-kitty": "workspace:*",
    "@opengovsg/prettier-config-starter-kitty": "workspace:*",
    "@swc/core": "^1.6.13",
    "@types/node": "^20",
    "testcontainers": "^12.0.4",
    "typescript": "^5.4.5",
    "vite": "^7.3.5",
    "vitest": "^4.1.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "prettier": "@opengovsg/prettier-config-starter-kitty"
}
